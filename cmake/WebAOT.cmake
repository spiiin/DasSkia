option(DASSKIA_WEB_AOT "Build actual wasm32 strict AOT runner and Node generator" OFF)
if(NOT EMSCRIPTEN OR NOT DASSKIA_WEB_AOT)
    return()
endif()
find_program(DASSKIA_NODE node REQUIRED)
set(DASSKIA_NODE_FLAGS "--experimental-wasm-exnref" CACHE STRING "Node flags for pinned Wasm exception ABI")
separate_arguments(_node_flags NATIVE_COMMAND "${DASSKIA_NODE_FLAGS}")
include(${CMAKE_CURRENT_LIST_DIR}/ScriptInventory.cmake)
list(APPEND scripts tests/aot_import_missing.das)
add_executable(dasSkia_web_aot_generator tools/aot.cpp)
add_executable(dasSkia_web_aot_runner src/runner.cpp)
foreach(t dasSkia_web_aot_generator dasSkia_web_aot_runner)
    target_link_libraries(${t} PRIVATE dasSkia)
    if(DASSKIA_WITH_DASSDL3)
        target_link_libraries(${t} PRIVATE dasSkia_sdl3)
    endif()
    target_compile_definitions(${t} PRIVATE DASSKIA_ROOT="${PROJECT_SOURCE_DIR}" DASSKIA_DAS_ROOT="${PROJECT_SOURCE_DIR}/third_party/daScript")
    set_target_properties(${t} PROPERTIES SUFFIX ".js")
    dasskia_web_package(${t})
endforeach()
set_target_properties(dasSkia_web_aot_generator PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/aot-tools")
target_link_options(dasSkia_web_aot_generator PRIVATE -sENVIRONMENT=node -sEXIT_RUNTIME=1 -lnodefs.js
    "SHELL:--pre-js ${PROJECT_SOURCE_DIR}/tools/aot_node_output.js")
set_property(TARGET dasSkia_web_aot_generator APPEND PROPERTY LINK_DEPENDS "${PROJECT_SOURCE_DIR}/tools/aot_node_output.js")
set_target_properties(dasSkia_web_aot_runner PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/aot-site")
target_compile_definitions(dasSkia_web_aot_runner PRIVATE DASSKIA_STRICT_AOT=1)
target_link_options(dasSkia_web_aot_runner PRIVATE -sEXIT_RUNTIME=0)
foreach(script IN LISTS scripts)
    string(SHA256 key "${script}")
    set(output "${CMAKE_BINARY_DIR}/aot-web/${key}.cpp")
    if(DASSKIA_WITH_DASSDL3 AND "${script}" STREQUAL "${_sdl_result_script}")
        get_filename_component(name "${script}" NAME)
        set(virtual_script "/dassdl3/${name}")
    else()
        set(virtual_script "/${script}")
    endif()
    add_custom_command(OUTPUT "${output}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/aot-web"
        COMMAND ${CMAKE_COMMAND} -E env "DASSKIA_AOT_OUTPUT_DIR=${CMAKE_BINARY_DIR}/aot-web"
            "${DASSKIA_NODE}" ${_node_flags} "$<TARGET_FILE:dasSkia_web_aot_generator>" "${virtual_script}" "/aot-output/${key}.cpp"
        WORKING_DIRECTORY "$<TARGET_FILE_DIR:dasSkia_web_aot_generator>"
        DEPENDS dasSkia_web_aot_generator "${PROJECT_SOURCE_DIR}/${script}" ${helpers} VERBATIM)
    target_sources(dasSkia_web_aot_runner PRIVATE "${output}")
endforeach()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/aot-site")
configure_file("${PROJECT_SOURCE_DIR}/web/index.html" "${CMAKE_BINARY_DIR}/aot-site/index.html")
file(READ "${CMAKE_BINARY_DIR}/aot-site/index.html" page)
string(REPLACE "dasSkia_runner.js" "dasSkia_web_aot_runner.js" page "${page}")
string(REPLACE "dasSkia · Skia Ganesh / WebGL 2" "dasSkia · strict AOT / WebGL 2" page "${page}")
file(WRITE "${CMAKE_BINARY_DIR}/aot-site/index.html" "${page}")
