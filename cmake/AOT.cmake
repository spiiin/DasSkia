option(DASSKIA_AOT_TESTS "Build strict native AOT checks" OFF)
if(NOT DASSKIA_AOT_TESTS OR EMSCRIPTEN)
    return()
endif()
add_executable(dasSkia_aot tools/aot.cpp)
add_executable(dasSkia_aot_runner src/runner.cpp)
foreach(t dasSkia_aot dasSkia_aot_runner)
    target_link_libraries(${t} PRIVATE dasSkia)
    if(DASSKIA_WITH_DASSDL3)
        target_link_libraries(${t} PRIVATE dasSkia_sdl3)
    endif()
    target_compile_definitions(${t} PRIVATE DASSKIA_ROOT="${PROJECT_SOURCE_DIR}"
        DASSKIA_DAS_ROOT="${PROJECT_SOURCE_DIR}/third_party/daScript")
    set_target_properties(${t} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
    dasskia_icu_data(${t})
    if(MSVC)
        target_compile_options(${t} PRIVATE /bigobj)
    endif()
endforeach()
target_compile_definitions(dasSkia_aot_runner PRIVATE DASSKIA_STRICT_AOT=1)
include(${CMAKE_CURRENT_LIST_DIR}/ScriptInventory.cmake)
foreach(script IN LISTS scripts)
    string(SHA256 key "${script}")
    set(output "${CMAKE_BINARY_DIR}/aot/${key}.cpp")
    add_custom_command(OUTPUT "${output}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/aot"
        COMMAND dasSkia_aot "${PROJECT_SOURCE_DIR}/${script}" "${output}"
        DEPENDS dasSkia_aot "${PROJECT_SOURCE_DIR}/${script}" ${helpers} VERBATIM)
    target_sources(dasSkia_aot_runner PRIVATE "${output}")
endforeach()
