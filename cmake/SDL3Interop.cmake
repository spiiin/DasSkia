option(DASSKIA_WITH_DASSDL3 "Build typed attachment to dasSDL3-owned GL windows" OFF)
set(DASSKIA_DASSDL3_ROOT "${PROJECT_SOURCE_DIR}/../dasSDL3" CACHE PATH "Pinned dasSDL3 source checkout")
if(NOT DASSKIA_WITH_DASSDL3)
    return()
endif()
if(NOT DASSKIA_WITH_SDL)
    message(FATAL_ERROR "dasSDL3 interop requires DASSKIA_WITH_SDL")
endif()
if(NOT EXISTS "${DASSKIA_DASSDL3_ROOT}/src/module_sdl3.cpp")
    message(FATAL_ERROR "Set DASSKIA_DASSDL3_ROOT to the pinned dasSDL3 checkout")
endif()
if(EMSCRIPTEN)
    set(_sdl_module "${DASSKIA_DASSDL3_ROOT}/web/module_web.cpp")
else()
    set(_sdl_module "${DASSKIA_DASSDL3_ROOT}/src/module_sdl3.cpp")
endif()
add_library(dasSkia_sdl3 STATIC ${_sdl_module} src/module_skia_sdl3.cpp)
target_link_libraries(dasSkia_sdl3 PUBLIC dasSkia)
target_include_directories(dasSkia_sdl3 PUBLIC "${DASSKIA_DASSDL3_ROOT}/src" "${DASSKIA_DASSDL3_ROOT}/web")
target_compile_definitions(dasSkia_sdl3 PUBLIC DASSKIA_WITH_DASSDL3=1 DASSKIA_DASSDL3_ROOT="${DASSKIA_DASSDL3_ROOT}")
if(MSVC)
    target_compile_options(dasSkia_sdl3 PUBLIC /bigobj)
    target_compile_definitions(dasSkia_sdl3 PUBLIC DASSDL3_TYPES_INCLUDE="generated/clangbind/sdl3_types.inc" DASSDL3_REGISTRATION_INCLUDE="generated/clangbind/sdl3_functions.inc" DASSDL3_AOT_HEADER="sdl3_aot.h")
endif()


if(BUILD_TESTING AND NOT EMSCRIPTEN)
    add_executable(dasSkia_texture_native tests/sdl_texture_native.cpp)
    target_link_libraries(dasSkia_texture_native PRIVATE dasSkia_sdl3)
    add_test(NAME sdl_texture_native COMMAND dasSkia_texture_native)
    add_executable(dasSkia_interop_native tests/sdl_interop_native.cpp)
    target_link_libraries(dasSkia_interop_native PRIVATE dasSkia_sdl3)
    if(MSVC)
        target_compile_options(dasSkia_interop_native PRIVATE /bigobj)
    endif()
    add_test(NAME sdl_interop_native COMMAND dasSkia_interop_native)
    add_executable(dasSkia_interop_events tests/sdl_interop_events.cpp)
    target_link_libraries(dasSkia_interop_events PRIVATE dasSkia_sdl3)
    target_compile_definitions(dasSkia_interop_events PRIVATE DASSKIA_ROOT="${PROJECT_SOURCE_DIR}"
        DASSKIA_DAS_ROOT="${PROJECT_SOURCE_DIR}/third_party/daScript")
    add_test(NAME sdl_interop_events COMMAND dasSkia_interop_events)
    set_tests_properties(sdl_interop_events PROPERTIES WORKING_DIRECTORY "${CMAKE_BINARY_DIR}" TIMEOUT 30)
endif()
